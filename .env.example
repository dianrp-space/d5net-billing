APP_ENV=development
# 0.0.0.0 = bisa diakses dari LAN; Vite juga bind 0.0.0.0:5173
HTTP_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://drp:drp_secret@127.0.0.1:5432/drp_billing?sslmode=disable
JWT_SECRET=change-me-to-random-64-char-string-in-production
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=720h
ENCRYPTION_KEY=01234567890123456789012345678901
# localhost + otomatis izinkan origin http(s)://192.168.100.x:*
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
UPLOAD_DIR=/var/lib/drp-billing/uploads
ROUTER_BACKUP_DIR=/var/lib/drp-billing/router-backups
WHATSAPP_SESSION_DIR=./data/whatsapp
DB_BACKUP_DIR=./data/db-backups
WORKER_ENABLED=true

# Optional notification providers (Telegram fallback / platform-level)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Optional payment gateways
MIDTRANS_SERVER_KEY=
XENDIT_SECRET_KEY=
TRIPAY_PRIVATE_KEY=
