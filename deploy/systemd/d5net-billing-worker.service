[Unit]
Description=d5net-billing Background Worker
After=network.target postgresql.service d5net-billing-api.service
Wants=postgresql.service

[Service]
Type=simple
User=dianrp
WorkingDirectory=/www/wwwroot/delimanet.dianrp.com
EnvironmentFile=/www/wwwroot/delimanet.dianrp.com/.env
ExecStart=/www/wwwroot/delimanet.dianrp.com/bin/d5net-billing-worker
Restart=always
RestartSec=5
LimitNOFILE=65535

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/www/wwwroot/delimanet.dianrp.com/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
