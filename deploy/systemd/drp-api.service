[Unit]
Description=drp-billing API Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=dianrp
WorkingDirectory=/www/wwwroot/billing.dianrp.com
EnvironmentFile=/www/wwwroot/billing.dianrp.com/.env
ExecStart=/www/wwwroot/billing.dianrp.com/bin/drp-api
Restart=always
RestartSec=5
LimitNOFILE=65535

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/www/wwwroot/billing.dianrp.com/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
